# Qualigrafo installation settings — copy to deploy/.env and fill in. Keep .env private (it holds passwords).

# --- Address and HTTPS
# Host name users open in the browser (DNS must point to this server).
DOMAIN=qualigrafo.customer.com
# auto = Let's Encrypt (public DNS, ports 80 + 443 reachable from the internet; set ACME_EMAIL)
# custom = certificate from your IT: put cert.pem (full chain) and key.pem into deploy/certs/
# internal = Caddy's own certificate authority (tests / closed networks; browsers must trust its root certificate)
TLS_MODE=custom
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
# Only when users reach the server on a non-standard port, e.g. https://qualigrafo.customer.com:8443
# APP_URL=https://qualigrafo.customer.com:8443

# --- Secrets (generate, e.g.: openssl rand -hex 32)
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-48-or-more-random-characters

# --- Site
# IANA time zone of the site: decides "today", due and overdue dates, and the daily reminder time.
APP_TIMEZONE=Asia/Riyadh
IDLE_TIMEOUT_MIN=15
JWT_EXPIRES_IN=12h
MAX_UPLOAD_MB=50
MAX_REQUEST_MB=100

# --- E-mail (leave SMTP_HOST empty to record e-mails as "Not sent")
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Qualigrafo <qualigrafo@customer.com>"

# --- Backups (daily, with an automatic test restore; schedule under Users & access → Backups)
# Host folder for the backup sets — use separate storage, e.g. a NAS mount. Default: Docker volume "backups".
# BACKUP_VOLUME=/mnt/nas/qualigrafo-backups

# --- Monitoring (P6)
# Logs: JSON lines on stdout (docker compose logs api) plus daily files in the api volume under /data/logs.
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=/data/logs
LOG_KEEP_DAYS=90
# Set a random token to let an uptime / monitoring tool read https://DOMAIN/api/metrics (Prometheus text format).
# Example: openssl rand -hex 24. Empty = the endpoint does not exist.
METRICS_TOKEN=

# --- Image tag (set to the release version when installing a release)
QUALIGRAFO_VERSION=local
