{
  "name": "qualigrafo-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "fixtures:load": "tsx fixtures/load.ts --confirm-wipe",
    "create-admin": "tsx scripts/create-admin.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "tsx scripts/api.test.ts",
    "validation:oq": "tsx scripts/validation-oq.ts",
    "validation:pack": "tsx scripts/validation-pack.ts",
    "backup:restore": "tsx scripts/backup-restore.ts",
    "perf:portfolio": "tsx scripts/perf-portfolio.ts",
    "migration:check": "tsx scripts/migration-check.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dejavu-fonts-ttf": "2.37.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "10.1.7",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
