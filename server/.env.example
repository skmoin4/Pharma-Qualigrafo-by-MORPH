DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/qualigrafo?schema=public"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="12h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
APP_TIMEZONE="Asia/Riyadh"
STORAGE_DIR="storage"
MAX_UPLOAD_MB=50
IDLE_TIMEOUT_MIN=15
# E-mail (SMTP). Leave SMTP_HOST empty to record e-mails in the outbox without sending them.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Qualigrafo <qualigrafo@customer.com>"
# Address of the web application, used for links in e-mails
APP_URL="https://qualigrafo.customer.com"
# Monitoring (P6). LOG_FORMAT: auto = JSON lines when NODE_ENV=production, readable text otherwise.
LOG_LEVEL="info"
LOG_FORMAT="auto"
# Folder for daily log files (kept LOG_KEEP_DAYS days); empty = console only (Docker collects it)
LOG_DIR=""
LOG_KEEP_DAYS=90
# Token for GET /api/metrics (uptime / monitoring tools, Prometheus text format); empty = endpoint switched off
METRICS_TOKEN=""
# Combined deploy (single service, e.g. Render free tier): path to the built frontend (../qualigrafo/dist)
# to serve alongside the API. Leave empty for the Docker deployment (Caddy serves it) or local dev (Vite).
STATIC_DIR=""
